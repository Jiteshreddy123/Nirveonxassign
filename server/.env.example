# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/employee_directory?retryWrites=true&w=majority

# JWT Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated for multiple origins)
# For local development: http://localhost:5173
# For production: https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
